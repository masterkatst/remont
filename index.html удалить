    var eve=W3.tod==='eve';
    hemi.intensity=eve?.22:.85;sun.intensity=eve?.05:.55;fill.intensity=eve?.12:.25;
    win.material.color.set(eve?0x2a3a52:0xd7ecf7);
    if(lampLight)lampLight.intensity=eve?1.1:.35;
    var bs=document.querySelectorAll('[data-walkctl="tod"]');
    for(var i=0;i<bs.length;i++)bs[i].setAttribute('aria-pressed',String(bs[i].getAttribute('data-v')===W3.tod));
  }
  applyTod();W3.applyTod=applyTod;
  function blocked(x,z){for(var i=0;i<blocks.length;i++){var b=blocks[i];if(x>b[0]-.2&&x<b[1]+.2&&z>b[2]-.2&&z<b[3]+.2)return true;}return false;}
  // input
  var drag=null;
  cv.onpointerdown=function(e){drag={x:e.clientX,y:e.clientY,m:0};try{cv.setPointerCapture(e.pointerId);}catch(x){}};
  cv.onpointermove=function(e){if(!drag)return;var dx=e.clientX-drag.x,dy=e.clientY-drag.y;drag.x=e.clientX;drag.y=e.clientY;drag.m+=Math.abs(dx)+Math.abs(dy);W3.yaw+=dx*.006;W3.pitch=Math.max(-1,Math.min(1,W3.pitch+dy*.004));};
  cv.onpointerup=function(e){
    var moved=drag?drag.m:99;drag=null;if(moved>6)return;
    var r=cv.getBoundingClientRect(),m=new THREE.Vector2(((e.clientX-r.left)/r.width)*2-1,-((e.clientY-r.top)/r.height)*2+1);
    var rc=new THREE.Raycaster();rc.setFromCamera(m,cam);var hit=rc.intersectObjects(sc.children,true)[0];
    var tip=document.getElementById('walkTip');if(!tip)return;
    var pid=null;if(hit){var o=hit.object;while(o&&!o.userData.pid)o=o.parent;if(o)pid=o.userData.pid;}
    if(pid&&String(pid).indexOf('ex:')===0){var ee=EX[String(pid).slice(3)];tip.innerHTML='<b>'+esc(ee.n)+'</b><br><span class="muted">Оставлен на месте, модель из скана</span><br><span class="small">В смету не входит, но учитывается при расстановке.</span>';tip.hidden=false;clearTimeout(W3.tipT);W3.tipT=setTimeout(function(){tip.hidden=true;},5000);return;}
    var x=pid&&by(pid);
    if(!x){tip.hidden=true;return;}
    tip.innerHTML='<b>'+esc(x.n)+'</b><br><span class="muted">'+esc(x.p)+' · '+stars(x.r)+' · '+money(x.pr)+(x.pack?'/м²':'')+'</span><br><span class="small">Позиция уже в смете. Партнёр увидит это как «показ в прогулке».</span>';
    tip.hidden=false;clearTimeout(W3.tipT);W3.tipT=setTimeout(function(){tip.hidden=true;},5000);
  };
  var last=performance.now();
  function tick(now){
    if(!document.body.contains(cv)){stopWalk();return;}
    var dt=Math.min(.05,(now-last)/1000);last=now;
    var k=W3.keys,mv=((k.fwd||k.KeyW||k.ArrowUp)?1:0)-((k.back||k.KeyS||k.ArrowDown)?1:0),st=(k.KeyD?1:0)-(k.KeyA?1:0),tr=((k.turnL||k.ArrowLeft)?1:0)-((k.turnR||k.ArrowRight)?1:0);
    W3.yaw+=tr*1.8*dt;
    if(mv||st){
      var sp=1.5*dt,fx=-Math.sin(W3.yaw),fz=-Math.cos(W3.yaw),rx=Math.cos(W3.yaw),rz=-Math.sin(W3.yaw);
      var nx=W3.x+(fx*mv+rx*st)*sp,nz=W3.z+(fz*mv+rz*st)*sp;
      nx=Math.max(-L/2+.3,Math.min(L/2-.3,nx));nz=Math.max(-Wd/2+.3,Math.min(Wd/2-.3,nz));
      if(!blocked(nx,W3.z))W3.x=nx;if(!blocked(W3.x,nz))W3.z=nz;
    }
    cam.position.set(W3.x,1.6,W3.z);cam.rotation.set(W3.pitch,W3.yaw,0);
    ren.render(sc,cam);W3.raf=requestAnimationFrame(tick);
  }
  W3.raf=requestAnimationFrame(tick);
}
document.addEventListener('keydown',function(e){if(!W3.ren||/INPUT|TEXTAREA/.test((e.target||{}).tagName||''))return;if(/^(KeyW|KeyA|KeyS|KeyD|Arrow(Up|Down|Left|Right))$/.test(e.code)){W3.keys[e.code]=true;e.preventDefault();}});
document.addEventListener('keyup',function(e){delete W3.keys[e.code];});
document.addEventListener('pointerdown',function(e){var b=e.target.closest&&e.target.closest('[data-walkctl="hold"]');if(b){W3.keys[b.getAttribute('data-k')]=true;e.preventDefault();}});
['pointerup','pointercancel'].forEach(function(n){document.addEventListener(n,function(){['turnL','turnR','fwd','back'].forEach(function(k){delete W3.keys[k];});});});
document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-walkctl="tod"]');if(b){W3.tod=b.getAttribute('data-v');if(W3.applyTod)W3.applyTod();}});

function render(){
  stopWalk();
  document.getElementById('app').innerHTML = S.mode==='user'?userView():partnerView();
  startWalk();
  document.getElementById('tab-user').setAttribute('aria-selected',S.mode==='user');
  document.getElementById('tab-partner').setAttribute('aria-selected',S.mode==='partner');
}
function toast(t){S.toast=t;render();setTimeout(function(){S.toast='';if(S.mode==='user')render();},2600);}

document.addEventListener('click',function(e){
  var el=e.target.closest('[data-act]'); if(!el) return;
  var a=el.getAttribute('data-act'), v=el.getAttribute('data-v');
  if(a==='mode'){S.mode=v;render();return;}
  if(a==='stage'){S.stage=v;}
  if(a==='go'){S.step=+v;}
  if(a==='back'){S.step=Math.max(0,S.step-1);}
  if(a==='next'){
    if(S.step===5&&S.sent){S.step=0;S.sent=null;S.crew=null;S.scan=0;}
    else if(S.step===5){S.sent=activeCrew().id;}
    else S.step=Math.min(5,S.step+1);
  }
  if(a==='scan'){S.scan=1;render();setTimeout(function(){S.scan=2;render();},1600);return;}
  if(a==='cat'){S.cat=v;}
  if(a==='pick'){
    if(S.cat==='wall')S.wall=v; else if(S.cat==='floor')S.floor=v; else S.furn[v]=!S.furn[v];
  }
  if(a==='ba'){S.ba=v;}
  if(a==='style'){S.style=v;fullRepair();S.lay=0;}
  if(a==='keep'){var kv=v.split(':');S.keep[kv[0]]=kv[1];S.lay=0;}
  if(a==='lay'){S.lay=+v;}
  if(a==='export'){toast('Формат '+v+': в прототипе файл не создаётся. В продукте экспорт откроется после утверждения варианта, число экспортов в бесплатном тарифе ограничено.');return;}
  if(a==='walk'){if(v==='l')S.walkP-=22;if(v==='r')S.walkP+=22;if(v==='f')S.walkZ=Math.min(1.8,S.walkZ+0.2);if(v==='b')S.walkZ=Math.max(1,S.walkZ-0.2);}
  if(a==='photo'){toast('Кадр поставлен в очередь: готовность до 10 минут, придёт уведомление. В тарифе заказчика осталось 2 кадра на комнату.');return;}
  if(a==='tab'){S.tab=v;}
  if(a==='sort'){S.sort=v;}
  if(a==='crew'){S.crew=v;}
  if(a==='tier'){S.tier=+v;}
  render();
});
document.addEventListener('input',function(e){
  var t=e.target;
  if(t.hasAttribute('data-dim')){
    var k=t.getAttribute('data-dim'), x=parseFloat(t.value);
    if(x>0){S.dim[k]=x;var g=geo();var f=document.getElementById('aF'),w=document.getElementById('aW');if(f)f.textContent=g.floor.toFixed(1)+' м²';if(w)w.textContent=g.wall.toFixed(1)+' м²';}
  }
  if(t.hasAttribute('data-ads')){
    S.ads=+t.value; var tt=TIERS[S.tier], sum=tt.pr+38400*tt.cm+S.ads;
    var set=function(id,txt){var n=document.getElementById(id);if(n)n.textContent=txt;};
    set('adv',money(S.ads));set('adshow','Примерно '+Math.round(S.ads*34).toLocaleString('ru-RU')+' дополнительных показов при выборе пола.');
    set('adsum',money(S.ads));set('totsum',money(sum));
  }
});
render();
})();
</script>
