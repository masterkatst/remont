<title>Ремонт в кадре</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600&family=Unbounded:wght@500;600&display=swap">
<style>
/* Layout: phone-sized customer app beside a "what this step proves" panel; partner cabinet as a second tab. */
:root{
  --bg:#F2F5F4; --surface:#FFFFFF; --surface-2:#E9EFEC; --ink:#13231F; --muted:#586966; --line:#D5DEDB;
  --accent:#0E7C6B; --accent-ink:#FFFFFF; --accent-soft:#DAF0EA;
  --warn:#9A6212; --warn-soft:#F7E8CC; --good:#1E7A3C; --bad:#B3321F;
  --font-body:"Onest",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --font-display:"Unbounded","Onest",system-ui,sans-serif;
  --shadow:0 1px 2px rgba(19,35,31,.06),0 8px 24px rgba(19,35,31,.07);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0D1614; --surface:#15221F; --surface-2:#1D2D29; --ink:#E5EFEC; --muted:#93A8A3; --line:#28393A;
    --accent:#3CCBB0; --accent-ink:#05201B; --accent-soft:#163A34;
    --warn:#E5AC4F; --warn-soft:#3A2E17; --good:#5FD08A; --bad:#FF8B77;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35); color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0D1614; --surface:#15221F; --surface-2:#1D2D29; --ink:#E5EFEC; --muted:#93A8A3; --line:#28393A;
  --accent:#3CCBB0; --accent-ink:#05201B; --accent-soft:#163A34;
  --warn:#E5AC4F; --warn-soft:#3A2E17; --good:#5FD08A; --bad:#FF8B77;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35); color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:14px;line-height:1.45;
  padding-block:16px 40px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--font-display);font-weight:600;margin:0;text-wrap:balance;letter-spacing:-.01em}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto}
.top{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;justify-content:space-between;margin-bottom:20px}
.brand{display:flex;flex-direction:column;gap:2px}
.brand h1{font-size:20px}
.brand span{color:var(--muted);font-size:13px}
.tabs{display:flex;gap:4px;background:var(--surface-2);padding:4px;border-radius:12px}
.tab{border:0;background:transparent;padding:8px 16px;border-radius:9px;font-weight:500;color:var(--muted)}
.tab[aria-selected="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.demo-note{font-size:12px;color:var(--muted);margin-top:16px}

/* customer */
.stage{display:grid;grid-template-columns:minmax(0,390px) minmax(0,1fr);gap:32px;align-items:start}
.phone{background:var(--surface);border:1px solid var(--line);border-radius:30px;box-shadow:var(--shadow);overflow:hidden;
  display:flex;flex-direction:column;height:min(780px,calc(100vh - 120px));min-height:640px}
.p-head{padding:14px 18px 10px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:8px}
.p-head h2{font-size:15px}
.steps{display:flex;gap:6px}
.dot{width:22px;height:6px;border-radius:4px;border:0;padding:0;background:var(--line)}
.dot[aria-current="step"]{background:var(--accent)}
.dot.done{background:var(--accent);opacity:.45}
.screen{flex:1;overflow:auto;padding:16px 18px 12px;display:flex;flex-direction:column;gap:14px}
.p-foot{display:flex;gap:10px;padding:12px 18px 16px;border-top:1px solid var(--line)}
.btn{border:1px solid var(--line);background:var(--surface);padding:11px 16px;border-radius:12px;font-weight:500}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.grow{flex:1}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.lead{color:var(--muted);margin:0}
.card{border:1px solid var(--line);border-radius:14px;padding:12px 14px;background:var(--surface)}
.card.sel{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset;background:var(--accent-soft)}
.row{display:flex;justify-content:space-between;gap:12px;align-items:baseline}
.muted{color:var(--muted)}
.small{font-size:12px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:6px 12px;font-size:13px}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.badge{display:inline-block;font-size:11px;padding:2px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:600}
.badge.warn{background:var(--warn-soft);color:var(--warn)}
.num{font-variant-numeric:tabular-nums}
.seg{display:flex;background:var(--surface-2);border-radius:10px;padding:3px;gap:2px}
.seg button{flex:1;border:0;background:transparent;padding:7px 8px;border-radius:8px;font-size:13px;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.room{border-radius:14px;overflow:hidden;border:1px solid var(--line);background:var(--surface-2)}
.room svg{display:block;width:100%;height:auto}
.room{position:relative}
.room canvas{display:block;width:100%;height:auto;touch-action:none;cursor:grab;background:#1b2321}
.room canvas:active{cursor:grabbing}
.tip{position:absolute;left:10px;right:10px;bottom:10px;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:8px 12px;font-size:13px;box-shadow:var(--shadow)}
.objrow{display:grid;grid-template-columns:minmax(0,1fr) 170px;gap:8px;align-items:center;padding:6px 0;border-top:1px solid var(--line)}
.objrow .seg button{padding:6px 4px}
@media (max-width:400px){.objrow{grid-template-columns:minmax(0,1fr)}}
.hold{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.hold .btn{touch-action:manipulation;user-select:none;padding:11px 6px}
.finder{position:relative;border-radius:14px;aspect-ratio:4/3;max-width:100%;overflow:hidden;border:1px solid var(--line);
  background:repeating-linear-gradient(0deg,var(--surface-2) 0 1px,transparent 1px 36px),repeating-linear-gradient(90deg,var(--surface-2) 0 1px,transparent 1px 36px),var(--surface)}
.finder .scan{position:absolute;left:0;right:0;height:3px;background:var(--accent);box-shadow:0 0 18px var(--accent);top:10%;animation:scan 1.6s ease-in-out infinite alternate}
.finder .cap{position:absolute;left:12px;bottom:10px;font-size:12px;color:var(--muted)}
@keyframes scan{to{top:88%}}
@media (prefers-reduced-motion:reduce){.finder .scan{animation:none}}
.dims{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.dims label{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}
.dims input{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:8px 10px;width:100%;min-width:0}
.prod{display:grid;grid-template-columns:34px minmax(0,1fr) auto;gap:10px;align-items:center;text-align:left;width:100%}
.sw{width:34px;height:34px;border-radius:9px;border:1px solid var(--line)}
.stars{color:var(--warn)}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line);vertical-align:top;font-size:13px}
th{font-weight:500;color:var(--muted);font-size:12px}
td.r,th.r{text-align:right}
.tbl{overflow-x:auto}
.total{display:flex;justify-content:space-between;align-items:baseline;padding:12px 14px;border-radius:14px;background:var(--accent);color:var(--accent-ink)}
.total strong{font-family:var(--font-display);font-size:20px}
.toast{position:sticky;bottom:0;background:var(--ink);color:var(--bg);padding:10px 14px;border-radius:12px;font-size:13px}

.side{display:flex;flex-direction:column;gap:16px;min-width:0}
.side .card{box-shadow:var(--shadow)}
.side h2{font-size:18px;margin-bottom:6px}
.flow{display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none}
.flow li{display:grid;grid-template-columns:22px minmax(0,1fr);gap:10px;color:var(--muted);align-items:start}
.flow li b{color:var(--ink);font-weight:500}
.flow .n{width:22px;height:22px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;font-size:11px}
.flow li.on .n{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.flow li.on{color:var(--ink)}
.flow li button{all:unset;cursor:pointer;display:contents}
.pay{background:var(--warn-soft);border-color:transparent;color:var(--ink)}
.pay h3{font-size:13px;color:var(--warn);margin-bottom:4px}

/* partner */
.grid{display:grid;gap:16px}
.g3{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.g2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.kpi{display:flex;flex-direction:column;gap:2px}
.kpi b{font-family:var(--font-display);font-size:22px;font-weight:600}
.tier{text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:4px;min-width:0}
.tier[aria-pressed="true"]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset;background:var(--accent-soft)}
.bar{height:8px;border-radius:6px;background:var(--surface-2);overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent)}
input[type=range]{width:100%;accent-color:var(--accent)}
.sec-title{font-size:15px;margin-bottom:10px}
@media (max-width:900px){.stage{grid-template-columns:minmax(0,1fr)}.phone{max-width:420px;margin:0 auto;width:100%}}
</style>

<div class="wrap">
  <header class="top">
    <div class="brand">
      <h1>Ремонт в кадре</h1>
      <span>Кликабельный прототип: от фото комнаты до сметы и бригады</span>
    </div>
    <div class="tabs" role="tablist" aria-label="Режим прототипа">
      <button class="tab" role="tab" id="tab-user" aria-selected="true" data-act="mode" data-v="user">Заказчик</button>
      <button class="tab" role="tab" id="tab-partner" aria-selected="false" data-act="mode" data-v="partner">Кабинет партнёра</button>
    </div>
  </header>
  <main id="app"></main>
  <p class="demo-note">Демо-данные: партнёры, товары, цены и отзывы вымышленные. Расчёты количества и сметы работают по формулам из ТЗ.</p>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
var CAT = {
  wall:[
    {id:'w1',n:'Краска «Шалфей», матовая',p:'СтройДом',r:4.7,c:'#A9B8A0',k:'paint',pr:38,note:'банка 5 л'},
    {id:'w2',n:'Краска «Белый лён»',p:'СтройДом',r:4.7,c:'#ECE9E1',k:'paint',pr:34,note:'банка 5 л'},
    {id:'w3',n:'Обои «Лён», флизелин',p:'ДекорМир',r:4.5,c:'#CDB89E',k:'paper',pr:21,note:'рулон 10 м'}
  ],
  floor:[
    {id:'f1',n:'Ламинат «Дуб светлый», 33 класс',p:'ПолМаркет',r:4.8,c:'#C9A878',k:'lam',pr:19.5,pack:2.4,note:'пачка 2,4 м²'},
    {id:'f2',n:'Ламинат «Орех тёмный», 33 класс',p:'ПолМаркет',r:4.8,c:'#6E4B35',k:'lam',pr:22,pack:2.4,note:'пачка 2,4 м²'},
    {id:'f3',n:'Плитка «Бетон» 60×60',p:'КерамХаус',r:4.4,c:'#8E9396',k:'tile',pr:27,pack:1.44,note:'упаковка 1,44 м²'}
  ],
  furn:[
    {id:'sofa',n:'Диван «Норд», 3-местный',p:'ЛюксМебель',r:4.6,c:'#3E5C76',k:'sofa',pr:640,note:'2,1 × 0,95 м'},
    {id:'lamp',n:'Торшер «Арка»',p:'СветЛайн',r:4.9,c:'#D9A441',k:'lamp',pr:85,note:'высота 1,8 м'}
  ]
};
var CREWS = [
  {id:'c1',n:'Мастер-Про',r:4.8,rev:127,days:5,paint:7,paper:6,lam:9,tile:24,plinth:2.5,asm:30},
  {id:'c2',n:'Ремонт 24',r:4.5,rev:203,days:3,paint:6,paper:5,lam:8,tile:20,plinth:2,asm:25},
  {id:'c3',n:'Точный метр',r:4.9,rev:58,days:9,paint:8.5,paper:7,lam:11,tile:27,plinth:3,asm:40}
];
var STEPS = ['Объект','Замеры','Что меняем','Визуализация','Смета','Бригады'];
var NOTES = [
  {t:'Начало',x:'Заказчик заводит объект и отмечает стадию ремонта. От стадии зависит набор работ и материалов в смете.',pay:''},
  {t:'Скан и 3D-модель',x:'Размеры и предметы комнаты получаются из LiDAR или видео. Приложение узнаёт кровать, шкаф, кухню и их габариты. Числа можно поправить, смета пересчитается.',pay:''},
  {t:'Что оставить и как расставить',x:'Кухню, кровать и шкаф можно оставить на месте: они не меняются, не попадают в смету, а мебель расставляется вокруг них. Новые товары берутся из каталога; в начале это модели с открытыми лицензиями, позже поставщики загрузят свои.',pay:'Здесь поставщик получает показ: реклама «товар в фокусе» и рейтинг двигают позицию в списке.'},
  {t:'Визуализация',x:'Быстрый эскиз готов за минуту. Фотореалистичный кадр и 3D-прогулка строятся из 3D-моделей и материалов партнёров и стоят платформе вычислений на GPU.',pay:'Каждый показ товара в визуализации попадает в статистику партнёра.'},
  {t:'Смета материалов и работ',x:'Количество считается по площадям и нормам расхода, округляется до упаковки. Строки сгруппированы по партнёрам.',pay:'Покупка по смете даёт комиссию платформе: в модели 6% с материалов и 8% с работ.'},
  {t:'Подбор бригад',x:'Цена считается по прайсу каждой бригады на одном и том же объёме. Рейтинг растёт от завершённых заказов.',pay:'Бригада платит подписку, комиссию с заказа и может купить место в подборе.'}
];
var S = {mode:'user',step:0,stage:'Черновая',scan:0,dim:{L:5.2,W:3.8,H:2.7},keep:{bed:'keep',wardrobe:'keep',kitchen:'keep'},lay:0,wall:'w1',floor:'f1',furn:{sofa:true,lamp:true},style:'Светлый',budget:3000,walkZ:1,walkP:0,
  cat:'wall',ba:'after',tab:'mat',sort:'price',crew:null,sent:null,toast:'',tier:1,ads:300};

function all(){return CAT.wall.concat(CAT.floor,CAT.furn);}
function by(id){return all().filter(function(x){return x.id===id;})[0];}
function money(n){return '$'+Math.round(n).toLocaleString('ru-RU');}
function money2(n){return '$'+n.toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2});}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function stars(r){return '<span class="stars">★</span> '+r.toFixed(1).replace('.',',');}

function geo(){
  var d=S.dim, perim=2*(d.L+d.W);
  return {floor:d.L*d.W, perim:perim, wall:Math.max(0,perim*d.H-4)};
}
function materials(){
  var g=geo(), w=by(S.wall), f=by(S.floor), m=[], q;
  if(w.k==='paint'){
    var lit=g.wall*2/8*1.1;
    m.push({n:w.n,p:w.p,q:Math.ceil(lit/5),u:'банка 5 л',pr:w.pr,how:g.wall.toFixed(1)+' м² × 2 слоя ÷ 8 м²/л + 10% = '+lit.toFixed(1)+' л'});
    m.push({n:'Грунтовка глубокого проникновения, 10 л',p:'СтройДом',q:Math.ceil(g.wall*1.1/80),u:'канистра',pr:24,how:'около 80 м² на канистру'});
  } else {
    var rolls=Math.ceil(g.wall*1.1/5);
    m.push({n:w.n,p:w.p,q:rolls,u:'рулон',pr:w.pr,how:g.wall.toFixed(1)+' м² + 10% на подгонку ÷ 5 м² полезной площади'});
    m.push({n:'Клей для флизелиновых обоев',p:'ДекорМир',q:Math.ceil(rolls/8),u:'пачка',pr:12,how:'1 пачка на 8 рулонов'});
  }
  var k=f.k==='tile'?1.12:1.08;
  q=Math.ceil(g.floor*k/f.pack);
  m.push({n:f.n,p:f.p,q:q,u:f.k==='tile'?'упаковка':'пачка',pr:f.pr*f.pack,how:g.floor.toFixed(1)+' м² + '+Math.round((k-1)*100)+'% запас ÷ '+String(f.pack).replace('.',',')+' м²'});
  if(f.k==='tile') m.push({n:'Плиточный клей, 25 кг',p:'КерамХаус',q:Math.ceil(g.floor/5),u:'мешок',pr:11,how:'1 мешок на 5 м²'});
  else m.push({n:'Подложка под ламинат, 10 м²',p:'ПолМаркет',q:Math.ceil(g.floor*1.05/10),u:'рулон',pr:14,how:g.floor.toFixed(1)+' м² + 5%'});
  m.push({n:'Плинтус напольный, 2,5 м',p:'ПолМаркет',q:Math.ceil((g.perim-0.9)*1.05/2.5),u:'шт.',pr:4.5,how:'периметр минус дверь, +5%'});
  ['sofa','lamp'].forEach(function(id){ if(S.furn[id]){var x=by(id); m.push({n:x.n,p:x.p,q:1,u:'шт.',pr:x.pr,how:'по выбору'});} });
  m.forEach(function(x){x.sum=x.q*x.pr;});
  return m;
}
function works(c){
  var g=geo(), w=by(S.wall), f=by(S.floor), cnt=(S.furn.sofa?1:0)+(S.furn.lamp?1:0), a=[];
  a.push({n:w.k==='paint'?'Подготовка и покраска стен':'Поклейка обоев',q:g.wall,u:'м²',pr:w.k==='paint'?c.paint:c.paper});
  a.push({n:f.k==='tile'?'Укладка плитки':'Укладка ламината',q:g.floor,u:'м²',pr:f.k==='tile'?c.tile:c.lam});
  a.push({n:'Монтаж плинтуса',q:g.perim-0.9,u:'м',pr:c.plinth});
  if(cnt) a.push({n:'Сборка и установка мебели и света',q:cnt,u:'шт.',pr:c.asm});
  var rem=['bed','wardrobe','kitchen'].filter(function(k){return S.keep[k]==='remove';}).length;
  if(rem) a.push({n:'Демонтаж и вывоз мебели',q:rem,u:'шт.',pr:25});
  a.forEach(function(x){x.sum=x.q*x.pr;});
  return a;
}
function worksTotal(c){return works(c).reduce(function(s,x){return s+x.sum;},0);}
var STYLES={'Светлый':{wall:'w2',floor:'f1',sofa:true,lamp:true},'Тёплый':{wall:'w3',floor:'f1',sofa:true,lamp:true},'Графит':{wall:'w1',floor:'f2',sofa:true,lamp:false},'Лофт':{wall:'w2',floor:'f3',sofa:false,lamp:true}};
function fullRepair(){var o=STYLES[S.style];S.wall=o.wall;S.floor=o.floor;S.furn={sofa:o.sofa,lamp:o.lamp};}
function walkVB(){var z=S.walkZ,w=320/z,h=200/z,lim=(320-w)/2,p=Math.max(-lim,Math.min(lim,S.walkP));S.walkP=p;return ((320-w)/2+p).toFixed(1)+' '+((200-h)/2).toFixed(1)+' '+w.toFixed(1)+' '+h.toFixed(1);}

/* furniture layout (prototype solver) */
var EX={bed:{n:'Кровать 160×200',s:'кровать',h:.5},wardrobe:{n:'Шкаф-купе 120×60',s:'шкаф',h:2.2},kitchen:{n:'Кухонный гарнитур 220×60',s:'кухня',h:.9}};
function exRect(id){var L=S.dim.L,W=S.dim.W,a=-L/2,b=L/2,c=-W/2;
  if(id==='bed')return {x0:a,x1:a+2,z0:c,z1:c+1.6};
  if(id==='kitchen')return {x0:b-.6,x1:b,z0:c,z1:c+2.2};
  return {x0:b-.6,x1:b,z0:c+2.4,z1:c+3.6};}
function doorZone(){var L=S.dim.L,W=S.dim.W;return {x0:-L/2,x1:-L/2+.9,z0:W/2-1.35,z1:W/2-.45};}
function ov(r,q,m){return r.x0<q.x1+m&&r.x1>q.x0-m&&r.z0<q.z1+m&&r.z1>q.z0-m;}
function inRoom(r){var L=S.dim.L,W=S.dim.W,e=1e-6;return r.x0>=-L/2-e&&r.x1<=L/2+e&&r.z0>=-W/2-e&&r.z1<=W/2+e;}
function keptRects(){return ['bed','wardrobe','kitchen'].filter(function(k){return S.keep[k]==='keep';}).map(exRect);}
function computeLayouts(){
  var L=S.dim.L,W=S.dim.W,a=-L/2,b=L/2,c=-W/2,d=W/2,kept=keptRects(),dz=doorZone(),cand=[],out=[],i,t;
  function lampFor(sr){
    var sp=[],q;
    if(sr){
      var fw=(sr.z0>=d-1),bw=(sr.z1<=c+1),lw=(sr.x1<=a+1),rw=(sr.x0>=b-1);
      if(fw||bw){var zz=fw?d-.4:c+.4;sp=[[sr.x1+.4,zz],[sr.x0-.4,zz]];}
      else if(lw||rw){var xx=lw?a+.4:b-.4;sp=[[xx,sr.z1+.4],[xx,sr.z0-.4]];}
    } else sp=[[a+.4,c+.4],[b-.4,c+.4],[a+.4,d-.4],[b-.4,d-.4]];
    for(i=0;i<sp.length;i++){
      q={x0:sp[i][0]-.3,x1:sp[i][0]+.3,z0:sp[i][1]-.3,z1:sp[i][1]+.3};
      if(!inRoom(q)||ov(q,dz,0)||(sr&&ov(q,sr,.05)))continue;
      var bad=false;for(var j=0;j<kept.length;j++)if(ov(q,kept[j],.3))bad=true;
      if(!bad)return {x:sp[i][0],z:sp[i][1]};
    }
    return null;
  }
  if(!S.furn.sofa){return [{sofa:null,lamp:S.furn.lamp?lampFor(null):null,wall:'—'}];}
  function add(wall,tt,r,rot,sc){
    if(!inRoom(r)||ov(r,dz,0))return;
    for(var k=0;k<kept.length;k++)if(ov(r,kept[k],.7))return;
    cand.push({wall:wall,t:tt,r:r,rot:rot,sc:sc});
  }
  for(t=a+1.05;t<=b-1.05+1e-6;t+=.25){
    add('front',t,{x0:t-1.05,x1:t+1.05,z0:d-.95,z1:d},Math.PI,3-Math.abs(t)*.3);
    add('back',t,{x0:t-1.05,x1:t+1.05,z0:c,z1:c+.95},0,1-Math.abs(t)*.3);
  }
  for(t=c+1.05;t<=d-1.05+1e-6;t+=.25){
    add('left',t,{x0:a,x1:a+.95,z0:t-1.05,z1:t+1.05},Math.PI/2,1.5-Math.abs(t)*.3);
    add('right',t,{x0:b-.95,x1:b,z0:t-1.05,z1:t+1.05},-Math.PI/2,1.5-Math.abs(t)*.3);
  }
  cand.sort(function(p,q){return q.sc-p.sc;});
  cand.forEach(function(cd){
    if(out.length>=3)return;
    for(var k=0;k<out.length;k++)if(out[k].wall===cd.wall&&Math.abs(out[k].t-cd.t)<.5)return;
    out.push({wall:cd.wall,t:cd.t,rot:cd.rot,r:cd.r,sofa:{x:(cd.r.x0+cd.r.x1)/2,z:(cd.r.z0+cd.r.z1)/2,rot:cd.rot,r:cd.r},lamp:S.furn.lamp?lampFor(cd.r):null});
  });
  return out;
}
function curLayout(){var l=computeLayouts();return l.length?l[Math.min(S.lay,l.length-1)]:null;}
function planSVG(){
