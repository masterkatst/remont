  s+='<text x="'+(m+6)+'" y="'+(parseFloat(Z(dz.z0))-5).toFixed(1)+'" font-size="9.5" style="fill:var(--muted)">дверь</text>';
  ['bed','wardrobe','kitchen'].forEach(function(id){
    var r=exRect(id);
